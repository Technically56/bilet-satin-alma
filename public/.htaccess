# Disable directory listing
Options -Indexes

# Follow symlinks
Options +FollowSymLinks

# Default index file
DirectoryIndex index.php

# Custom error documents
ErrorDocument 404 /notfound.php
ErrorDocument 403 /notfound.php
<FilesMatch "\.(db|sqlite|env|ini|log|sh|bak|sql)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} \.(db|sqlite|env|ini|log|sh|bak|sql)$ [NC]
    RewriteRule .* - [R=404,L]
</IfModule>
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>